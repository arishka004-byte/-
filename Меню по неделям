<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Меню на 5 недель</title>
<style>
:root{
  --bg:#faf6ec; --card:#ffffff; --ink:#26332b; --muted:#6f7b72;
  --green:#4f7a5a; --green-d:#3b5f45; --green-l:#e4eee4; --line:#e8e1cf;
  --shadow:0 6px 20px rgba(60,80,60,.08); --r:18px;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;line-height:1.45;overflow-x:hidden}
.wrap{max-width:1080px;margin:0 auto;padding:28px 16px 56px}
header h1{margin:0 0 6px;font-size:clamp(26px,5vw,38px);letter-spacing:-.02em}
header p{margin:0;color:var(--muted)}
.tabs{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;margin:22px 0 8px}
.tab{border:1.5px solid var(--line);background:var(--card);color:var(--ink);border-radius:14px;
  padding:14px 8px;font:inherit;font-weight:600;cursor:pointer;min-height:52px;box-shadow:var(--shadow);
  transition:transform .15s,background .15s,color .15s,border-color .15s}
.tab small{display:block;font-weight:500;color:var(--muted);font-size:12px;margin-top:2px}
.tab:hover{transform:translateY(-1px)}
.tab.active{background:var(--green);border-color:var(--green);color:#fff}
.tab.active small{color:#e4eee4}
.tab:focus-visible,.btn:focus-visible{outline:3px solid #9cc3a5;outline-offset:2px}
.week-title{display:flex;flex-wrap:wrap;gap:10px 16px;align-items:baseline;justify-content:space-between;margin:28px 0 4px}
.week-title h2{margin:0;font-size:clamp(22px,4vw,30px)}
.week-title .sum{color:var(--green-d);font-weight:700;font-size:18px}
h3.sec{margin:28px 0 12px;font-size:14px;text-transform:uppercase;letter-spacing:.08em;color:var(--green-d)}
.grid{display:grid;gap:16px}
.grid.one{grid-template-columns:minmax(0,1fr)}
.grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}
.grid.four{grid-template-columns:repeat(4,minmax(0,1fr))}
.dish{background:var(--card);border-radius:var(--r);overflow:hidden;box-shadow:var(--shadow);border:1px solid var(--line);display:flex;flex-direction:column}
.ph{position:relative;aspect-ratio:4/3;background:var(--green-l);overflow:hidden}
.ph img{width:100%;height:100%;object-fit:cover;display:block}
.ph .fb{position:absolute;inset:0;display:none;align-items:center;justify-content:center;flex-direction:column;gap:6px;color:var(--green-d);font-size:44px}
.ph .fb span{font-size:13px;color:var(--muted)}
.ph.noimg .fb{display:flex}
.ph.noimg img{display:none}
.dish .t{padding:12px 14px 14px;font-weight:600}
.badge{display:inline-block;margin-top:6px;font-size:12px;font-weight:600;color:var(--green-d);background:var(--green-l);padding:3px 9px;border-radius:99px}
.panel{background:var(--card);border-radius:var(--r);box-shadow:var(--shadow);border:1px solid var(--line);padding:8px 16px 16px}
table{width:100%;border-collapse:collapse}
th,td{padding:11px 6px;text-align:left;border-bottom:1px solid var(--line);vertical-align:top}
th{font-size:12px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
td:nth-child(2),th:nth-child(2){white-space:nowrap}
td:last-child,th:last-child{text-align:right;white-space:nowrap}
.add{display:inline-block;font-size:11px;font-weight:600;color:#8a5a00;background:#fff1cf;border-radius:99px;padding:1px 7px;margin-left:6px;white-space:nowrap}
tfoot td{border:0;padding-top:16px;font-size:19px;font-weight:700;color:var(--green-d)}
.note{font-size:13px;color:var(--muted);margin:10px 2px 0}
.actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}
.btn{border:0;border-radius:14px;padding:14px 20px;font:inherit;font-weight:600;cursor:pointer;min-height:50px;background:var(--green);color:#fff}
.btn.sec{background:var(--green-l);color:var(--green-d)}
.btn:hover{filter:brightness(.96)}
.toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%) translateY(20px);background:var(--ink);color:#fff;
  padding:12px 18px;border-radius:12px;opacity:0;pointer-events:none;transition:.25s;font-size:14px;z-index:9}
.toast.show{opacity:1;transform:translateX(-50%)}
.budget{margin-top:30px;font-size:14px;color:var(--muted)}
@media(max-width:900px){.grid.four{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:640px){
  .tabs{grid-template-columns:repeat(3,1fr)}
  .grid.two{grid-template-columns:repeat(2,minmax(0,1fr))}
  .grid{gap:12px}
  .dish .t{padding:10px 11px 12px;font-size:14px}
  th,td{padding:10px 4px;font-size:14px}
  .btn{flex:1 1 100%}
}
@media print{
  body{background:#fff}
  .tabs,.actions,.toast,header p,.budget{display:none!important}
  .wrap{padding:0}
  .dish,.panel{box-shadow:none;break-inside:avoid}
  .grid.four{grid-template-columns:repeat(4,1fr)}
  .ph{aspect-ratio:4/3}
  .add{display:none}
  *{-webkit-print-color-adjust:exact;print-color-adjust:exact}
}
</style>
</head>
